[Unit]
Description=chat-arena API
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__/api
EnvironmentFile=__INSTALL_DIR__/api/.env.prod
# 内部包（packages/*、shared）以 TS 源码形式被引用，需要 tsx 加载器才能运行
ExecStart=/usr/bin/node --import tsx __INSTALL_DIR__/api/dist/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

# Sandboxing
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

LimitNOFILE=4096
MemoryMax=1G

[Install]
WantedBy=multi-user.target
