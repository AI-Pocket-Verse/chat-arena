server {
    listen 80;
    server_name __SERVER_NAME__;

    # Static frontend (built artifact)
    root __INSTALL_DIR__/web/dist;
    index index.html;

    # 安全响应头（location 里没有 add_header，会继承到所有请求）
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    location /api/ {
        proxy_pass http://127.0.0.1:4040;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # 覆盖而不是追加：api 的 TRUST_PROXY 默认只信本机反代，客户端自带的 X-Forwarded-For 不能透传
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 生成评测报告要等大模型返回，可能超过 1 分钟
        proxy_read_timeout 600s;
    }

    # 实时评测页的 WebSocket
    location /ws/ {
        proxy_pass http://127.0.0.1:4040;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    access_log /var/log/nginx/chat-arena.access.log;
    error_log  /var/log/nginx/chat-arena.error.log;
}
