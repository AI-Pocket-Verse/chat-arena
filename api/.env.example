# 配置模板。复制为 .env.dev（pnpm dev 读取）或 .env.prod（pnpm start 读取）后填写，
# 两者都不入库。每项的含义见 README「配置」一节。

NODE_ENV=development
HOST=127.0.0.1
PORT=4040

# SQLite 数据库，相对路径以 api/prisma/ 为基准；生产建议写绝对路径
DATABASE_URL=file:./dev.db

# 被测对话后端（接口约定见 docs/target-protocol.md）。默认指向 pnpm mock 启动的示例后端
TARGET_BASE_URL=http://localhost:8680
TARGET_DEBUG_KEY=mock-debug-key
# 可选：调被测后端时附加的请求头，JSON 对象，如 {"app_version":"9.9.9"}
TARGET_HEADERS=
# 允许发送 Debug Key / 额外请求头的被测后端 origin，逗号分隔，如 https://a.example.com,https://b.example.com。
# TARGET_BASE_URL 的 origin 始终允许；新建评测、角色库、连接测试填了名单外的地址会被拒绝（target_not_allowed）
TARGET_ALLOWED_ORIGINS=

# ── 模型 ─────────────────────────────────────────────────────────────────────
# 模拟用户、裁判、报告、人设库 AI 生成都要调用大模型（OpenAI 兼容接口）。
# 每家供应商三项：<前缀>_API_KEY、<前缀>_MODELS（模型名，逗号分隔）、<前缀>_BASE_URL（留空用官方地址）。
# 列在 *_MODELS 里的模型会出现在「新建评测」的模型下拉中，id 形如 qwen:qwen-plus。
# 只需配置实际用到的那几家；改完重启 pnpm dev（或 pnpm start）生效。

# 默认模型：新建评测页预选、人设库 AI 生成 / 反推 / 导入、示例后端扮演角色都用它。留空取第一个配好的模型
DEFAULT_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODELS=
OPENAI_BASE_URL=
# Anthropic（经官方 OpenAI 兼容接口调用）
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=
ANTHROPIC_BASE_URL=
# 火山方舟（豆包）
ARK_API_KEY=
ARK_MODELS=
ARK_BASE_URL=
# 阿里云百炼（千问，也托管 DeepSeek、Kimi、GLM 等模型）
QWEN_API_KEY=
QWEN_MODELS=
QWEN_BASE_URL=
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=
DEEPSEEK_BASE_URL=
# 智谱（GLM）
ZHIPU_API_KEY=
ZHIPU_MODELS=
ZHIPU_BASE_URL=
# 月之暗面（Kimi）
KIMI_API_KEY=
KIMI_MODELS=
KIMI_BASE_URL=
# MiniMax
MINIMAX_API_KEY=
MINIMAX_MODELS=
MINIMAX_BASE_URL=
# 自定义：任意 OpenAI 兼容服务，如本地 Ollama（http://127.0.0.1:11434/v1）、vLLM、OpenRouter。key 可留空
CUSTOM_API_KEY=
CUSTOM_MODELS=
CUSTOM_BASE_URL=

# 演示模型：由 pnpm mock 在 http://localhost:8680/v1 提供，按规则生成模拟用户、角色回复、评分和报告，
# 不调用任何真实模型、不需要 key，用来零配置体验完整流程。配好真实模型后可以删掉这一行
DEMO_MODELS=demo
DEMO_BASE_URL=

# 示例后端（pnpm mock）也读取本文件：角色回复默认用 DEFAULT_MODEL（或第一个配好的真实模型）生成；
# 设为其他模型 id 可单独指定，设为 off 只用演示模型（不产生费用）
# MOCK_MODEL=

# 可选：飞书登录（feishu-sso 的 whoami 地址），不设置为本地单用户模式
WHOAMI_URL=
# 启用登录后的管理员手机号，逗号分隔
ADMIN_MOBILES=
# 本地模式（未设置 WHOAMI_URL）只接受来自本机（localhost / 127.0.0.1）的访问。
# 通过其他域名或局域网 IP 访问时把主机名加在这里，逗号分隔，如 arena.example.com,192.168.1.20。
# 注意：本地模式不鉴权，名单里的地址谁都能用你的模型 key 发起评测
ALLOWED_HOSTS=
CORS_ORIGINS=
# 信任的反向代理：loopback（默认，只信本机 nginx）/ 逗号分隔的 IP·网段 / true / false
TRUST_PROXY=loopback

# 命令行冒烟脚本 api/src/cli/run-once.ts 的对话轮数（默认 6）
# MAX_TURNS=6
